{
  "__inputs": [
    {
      "name": "DS",
      "label": "Meraki",
      "type": "datasource",
      "pluginId": "dubsector-ciscomeraki-datasource"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.0"
    },
    {
      "type": "datasource",
      "id": "dubsector-ciscomeraki-datasource",
      "name": "Cisco Meraki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "title": "Meraki - Switching",
  "description": "Live port status for every switch in a network.",
  "tags": [
    "meraki",
    "switch"
  ],
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "${switch_serial:text}",
      "repeat": "switch_serial",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connected ports",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "switchPortStatuses",
          "deviceSerial": "${switch_serial}",
          "networkId": "${network}",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "status",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": "Connected"
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^portId$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ports with errors",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "switchPortStatuses",
          "deviceSerial": "${switch_serial}",
          "networkId": "${network}",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "errors",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": ".+"
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^portId$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Clients",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "switchPortStatuses",
          "deviceSerial": "${switch_serial}",
          "networkId": "${network}",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^clientCount$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "PoE energy",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "switchPortStatuses",
          "deviceSerial": "${switch_serial}",
          "networkId": "${network}",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/^powerUsageInWh$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "watth",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Ports",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "switchPortStatuses",
          "deviceSerial": "${switch_serial}",
          "networkId": "${network}",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "portId",
                "enabled",
                "status",
                "speed",
                "duplex",
                "isUplink",
                "clientCount",
                "trafficInKbps.total",
                "poe.isAllocated",
                "powerUsageInWh",
                "lldp.systemName",
                "errors",
                "warnings"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "portId": 0,
              "status": 1,
              "enabled": 2,
              "speed": 3,
              "duplex": 4,
              "isUplink": 5,
              "clientCount": 6,
              "trafficInKbps.total": 7,
              "poe.isAllocated": 8,
              "powerUsageInWh": 9,
              "lldp.systemName": 10,
              "errors": 11,
              "warnings": 12
            },
            "renameByName": {
              "portId": "Port",
              "status": "Status",
              "enabled": "Enabled",
              "speed": "Speed",
              "duplex": "Duplex",
              "isUplink": "Uplink",
              "clientCount": "Clients",
              "trafficInKbps.total": "Traffic",
              "poe.isAllocated": "PoE",
              "powerUsageInWh": "PoE energy",
              "lldp.systemName": "LLDP neighbor",
              "errors": "Errors",
              "warnings": "Warnings"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No switches in this network",
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "noValue",
                "value": ""
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Connected": {
                        "color": "green"
                      },
                      "Disconnected": {
                        "color": "text"
                      },
                      "Disabled": {
                        "color": "#8e8e8e"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warnings"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Traffic"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Kbits"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PoE energy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watth"
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "pluginId": "dubsector-ciscomeraki-datasource",
        "label": "Data Source",
        "hide": 0
      },
      {
        "name": "network",
        "type": "query",
        "label": "Network",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "query": "{\"queryType\":\"networks\",\"productTypes\":[\"switch\"]}",
        "refresh": 1,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "switch_serial",
        "type": "query",
        "label": "Switch",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "query": "{\"queryType\":\"devices\",\"networkId\":\"${network}\",\"productType\":\"switch\"}",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "version": 1,
  "id": null,
  "uid": ""
}
