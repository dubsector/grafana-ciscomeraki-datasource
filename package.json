{
  "name": "dubsector-ciscomeraki-datasource",
  "version": "2.0.0",
  "description": "Grafana datasource plugin for Cisco Meraki Dashboard API v1",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "server": "docker compose up --build",
    "sign": "sign-plugin"
  },
  "devDependencies": {
    "@grafana/sign-plugin": "^4.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@swc/core": "^1.16.21",
    "@swc/helpers": "^0.5.24",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "diagnostics-webpack-plugin": "^1.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "imports-loader": "^5.0.0",
    "oxlint": "^1.91.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "dependencies": {
    "@grafana/data": "^13.3.0",
    "@grafana/runtime": "^13.3.0",
    "@grafana/schema": "^13.2.1",
    "@grafana/ui": "^13.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "js-cookie": "3.0.8"
  },
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=22.23"
  }
}
