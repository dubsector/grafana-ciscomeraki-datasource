{
  "name": "dubsector-ciscomeraki-datasource",
  "version": "1.1.0",
  "description": "Grafana datasource plugin for Cisco Meraki Dashboard API v1",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "server": "docker-compose up --build"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "oxlint": "^1.86.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@grafana/data": "^13.2.3",
    "@grafana/runtime": "^13.2.3",
    "@grafana/schema": "^13.2.1",
    "@grafana/ui": "^13.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "js-cookie": "3.0.8"
  }
}
