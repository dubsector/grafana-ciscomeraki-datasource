{
  "__inputs": [
    {
      "name": "DS",
      "label": "Meraki",
      "type": "datasource",
      "pluginId": "dubsector-ciscomeraki-datasource"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.0"
    },
    {
      "type": "datasource",
      "id": "dubsector-ciscomeraki-datasource",
      "name": "Cisco Meraki",
      "version": "2.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "title": "Meraki - Organizations",
  "description": "Every organization the API key can see, with licensing and expiry. Built for MSPs.",
  "tags": [
    "meraki"
  ],
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "1h",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Organizations",
      "description": "Organizations the API key can see.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "licenseOverview",
          "allOrganizations": true,
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^organizationId$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Expire within 90 days",
      "description": "Co-termination organizations whose licenses end within 90 days.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "licenseOverview",
          "allOrganizations": true,
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "daysLeft",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              },
              {
                "fieldName": "daysLeft",
                "config": {
                  "id": "lower",
                  "options": {
                    "value": 90
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^organizationId$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Need attention",
      "description": "Organizations whose license status isn't OK, including ones the API key can't read.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "licenseOverview",
          "allOrganizations": true,
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "status",
                "config": {
                  "id": "regex",
                  "options": {
                    "value": "^(?!OK$).+"
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^organizationId$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Licensing by organization",
      "description": "Soonest expiry first. Per-device organizations show license counts by state instead of one expiry date.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "licenseOverview",
          "allOrganizations": true,
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "organizationId": true
            },
            "indexByName": {
              "organization": 0,
              "model": 1,
              "status": 2,
              "expirationDate": 3,
              "daysLeft": 4,
              "licensedDevices": 5,
              "active": 6,
              "expiring": 7,
              "expired": 8,
              "unused": 9
            },
            "renameByName": {
              "organization": "Organization",
              "model": "Licensing",
              "status": "Status",
              "expirationDate": "Expires",
              "daysLeft": "Days left",
              "licensedDevices": "Licensed devices",
              "active": "Active",
              "expiring": "Expiring",
              "expired": "Expired",
              "unused": "Unused"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "daysLeft"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "green",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expirationDate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD"
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".+",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expired"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "pluginId": "dubsector-ciscomeraki-datasource",
        "label": "Data Source",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "version": 1,
  "id": null,
  "uid": ""
}
