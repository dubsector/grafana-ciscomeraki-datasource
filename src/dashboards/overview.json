    {
      "id": 8,
      "type": "row",
      "title": "Open alerts",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Open alerts",
      "description": "Alerts open right now, most severe first.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "assuranceAlerts",
          "organizationId": "${org}",
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "startedAt",
                "severity",
                "title",
                "networkName",
                "devices",
                "description"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "severity": 0,
              "title": 1,
              "networkName": 2,
              "devices": 3,
              "startedAt": 4,
              "description": 5
            },
            "renameByName": {
              "severity": "Severity",
              "title": "Alert",
              "networkName": "Network",
              "devices": "Devices",
              "startedAt": "Since",
              "description": "Details"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0,
                        "text": "Critical"
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1,
                        "text": "Warning"
                      },
                      "informational": {
                        "color": "blue",
                        "index": 2,
                        "text": "Informational"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "startedAt"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "WAN uplinks",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Uplink loss and latency",
      "description": "Every appliance uplink, averaged over the last 5 minutes, worst first.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "uplinkLossLatency",
          "organizationId": "${org}",
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "networkName",
                "name",
                "uplink",
                "ip",
                "lossPercent",
                "latencyMs",
                "maxLatencyMs"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "networkName": 0,
              "name": 1,
              "uplink": 2,
              "ip": 3,
              "lossPercent": 4,
              "latencyMs": 5,
              "maxLatencyMs": 6
            },
            "renameByName": {
              "networkName": "Network",
              "name": "Appliance",
              "uplink": "Uplink",
              "ip": "Probe",
              "lossPercent": "Loss",
              "latencyMs": "Latency",
              "maxLatencyMs": "Peak latency"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lossPercent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/latencyMs|maxLatencyMs/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 100
                    },
                    {
                      "color": "red",
                      "value": 250
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Uplink detail: $network",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Uplink usage",
      "description": "Bits per second sent and received on each WAN uplink of the selected network.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "applianceUplinkUsage",
          "organizationId": "${org}",
          "networkId": "${network}",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Loss and latency: $appliance $uplink",
      "description": "Loss, latency and jitter towards 8.8.8.8 on the selected uplink.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "uplinkLossLatencyHistory",
          "organizationId": "${org}",
          "networkId": "${network}",
          "deviceSerial": "${appliance}",
          "productType": "",
          "historical": false,
          "uplink": "${uplink}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Loss"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
