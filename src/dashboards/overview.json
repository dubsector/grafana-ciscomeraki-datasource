        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "assuranceAlerts",
          "organizationId": "${org}",
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^title$/"
        },
