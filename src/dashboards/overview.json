{
  "__inputs": [
    {
      "name": "DS",
      "label": "Meraki",
      "type": "datasource",
      "pluginId": "dubsector-ciscomeraki-datasource"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.0.0"
    },
    {
      "type": "datasource",
      "id": "dubsector-ciscomeraki-datasource",
      "name": "Cisco Meraki",
      "version": "2.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "title": "Meraki - Overview",
  "description": "Organization health at a glance: device status, open alerts and WAN uplink quality.",
  "tags": [
    "meraki"
  ],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "1m",
  "annotations": {
    "list": [
      {
        "name": "Meraki alerts",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "queryType": "assuranceAlerts",
          "organizationId": "${org}",
          "networkId": "${network}",
          "historical": true
        }
      }
    ]
  },
  "version": 1,
  "id": null,
  "uid": "",
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "pluginId": "dubsector-ciscomeraki-datasource",
        "label": "Data Source",
        "hide": 0
      },
      {
        "name": "org",
        "type": "query",
        "label": "Organization",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "query": "{\"queryType\":\"organizations\"}",
        "refresh": 1,
        "sort": 0,
        "hide": 0
      },
      {
        "name": "network",
        "type": "query",
        "label": "Network",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "query": "{\"queryType\":\"networks\",\"organizationId\":\"${org}\",\"productTypes\":[\"appliance\"]}",
        "refresh": 1,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "appliance",
        "type": "query",
        "label": "Appliance",
        "datasource": {
          "type": "dubsector-ciscomeraki-datasource",
          "uid": "${DS}"
        },
        "query": "{\"queryType\":\"devices\",\"organizationId\":\"${org}\",\"networkId\":\"${network}\",\"productType\":\"appliance\"}",
        "refresh": 1,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "uplink",
        "type": "custom",
        "label": "Uplink",
        "query": "wan1,wan2,cellular",
        "current": {
          "text": "wan1",
          "value": "wan1"
        },
        "options": [
          {
            "text": "wan1",
            "value": "wan1",
            "selected": true
          },
          {
            "text": "wan2",
            "value": "wan2",
            "selected": false
          },
          {
            "text": "cellular",
            "value": "cellular",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Organization",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Online",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "dubsector-ciscomeraki-datasource",
        "uid": "${DS}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "deviceAvailabilities",
          "organizationId": "${org}",
          "networkId": "",
          "deviceSerial": "",
          "productType": "",
          "historical": false
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "status",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": "online"
                  }
                }
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "count"
          ],
          "fields": "/^serial$/"
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
