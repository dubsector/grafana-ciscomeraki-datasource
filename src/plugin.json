{
    "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
    "type": "datasource",
    "name": "Cisco Meraki",
    "id": "dubsector-ciscomeraki-datasource",
    "metrics": true,
    "backend": true,
    "alerting": true,
    "executable": "gpx_dubsector_meraki",
    "info": {
        "description": "Grafana datasource for the Cisco Meraki Dashboard API v1",
        "author": {
            "name": "dubsector",
            "url": "https://github.com/dubsector"
        },
        "keywords": [
            "datasource",
            "meraki",
            "cisco",
            "networking"
        ],
        "logos": {
            "small": "img/cisco-meraki-logo.svg",
            "large": "img/cisco-meraki-logo.svg"
        },
        "links": [
            {
                "name": "Website",
                "url": "https://github.com/dubsector/grafana-ciscomeraki-datasource"
            },
            {
                "name": "Report an issue",
                "url": "https://github.com/dubsector/grafana-ciscomeraki-datasource/issues"
            },
            {
                "name": "License",
                "url": "https://github.com/dubsector/grafana-ciscomeraki-datasource/blob/main/LICENSE"
            }
        ],
        "screenshots": [
            {
                "name": "Device health",
                "path": "img/screenshots/device-health.png"
            },
            {
                "name": "Switching",
                "path": "img/screenshots/switching.png"
            },
            {
                "name": "Wireless",
                "path": "img/screenshots/wireless.png"
            },
            {
                "name": "Security and SD-WAN",
                "path": "img/screenshots/security-and-sd-wan.png"
            }
        ],
        "version": "2.0.0",
        "updated": "2026-11-07"
    },
    "includes": [
        {
            "type": "dashboard",
            "name": "Meraki - Network Events",
            "path": "dashboards/network-events.json"
        },
        {
            "type": "dashboard",
            "name": "Meraki - Security & SD-WAN",
            "path": "dashboards/security-sdwan.json"
        },
        {
            "type": "dashboard",
            "name": "Meraki - Switching",
            "path": "dashboards/switching.json"
        },
        {
            "type": "dashboard",
            "name": "Meraki - Wireless",
            "path": "dashboards/wireless.json"
        },
        {
            "type": "dashboard",
            "name": "Meraki - Sensors",
            "path": "dashboards/sensors.json"
        },
        {
            "type": "dashboard",
            "name": "Meraki - Device Health",
            "path": "dashboards/device-health.json"
        }
    ],
    "dependencies": {
        "grafanaDependency": ">=11.5.0",
        "plugins": []
    }
}
